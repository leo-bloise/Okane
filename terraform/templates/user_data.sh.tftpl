#!/bin/bash
set -euxo pipefail

# Install Docker Engine + the Compose plugin.
curl -fsSL https://get.docker.com | sh
systemctl enable --now docker
usermod -aG docker ${ssh_user}

apt-get update
apt-get install -y awscli jq

curl -fsSL -o /usr/local/bin/dbmate https://github.com/amacneil/dbmate/releases/latest/download/dbmate-linux-amd64
chmod +x /usr/local/bin/dbmate

mkdir -p /opt/okane

cat <<'COMPOSE_EOF' > /opt/okane/docker-compose.yml
${docker_compose_content}
COMPOSE_EOF

cat <<'ENV_EOF' > /opt/okane/.env
${env_file_content}
ENV_EOF
chmod 600 /opt/okane/.env

%{ for path, content in support_files ~}
mkdir -p "/opt/okane/$(dirname "${path}")"
cat <<'FILE_EOF' > "/opt/okane/${path}"
${content}
FILE_EOF
%{ endfor ~}

mkdir -p /opt/okane/certbot/www /opt/okane/certbot/conf

# Fetches the RDS master password from Secrets Manager and applies any
# not-yet-applied files in Migrations/ via dbmate (idempotent - dbmate tracks
# applied migrations in a schema_migrations table on the target database).
# Written as its own script so it can also be re-run manually over SSH for a
# migration-only redeploy, without recreating the instance:
#   ssh ${ssh_user}@<eip> 'sudo /opt/okane/migrate.sh'
cat <<'MIGRATE_EOF' > /opt/okane/migrate.sh
#!/bin/bash
set -euxo pipefail

DB_PASSWORD=$(aws secretsmanager get-secret-value \
  --region ${aws_region} \
  --secret-id '${db_secret_arn}' \
  --query SecretString --output text | jq -r .password)

# The RDS-generated password can contain characters (e.g. [ ] ? ( > ) that are
# unsafe unescaped in a URL or in a semicolon-delimited connection string, so
# each usage below gets its own escaping.
DB_PASSWORD_URLENC=$(jq -rn --arg v "$DB_PASSWORD" '$v|@uri')

export DATABASE_URL="postgres://${db_username}:$DB_PASSWORD_URLENC@${db_host}:${db_port}/${db_name}?sslmode=require"
dbmate --migrations-dir /opt/okane/Migrations up

DB_PASSWORD_ESCAPED=$(printf '%s' "$DB_PASSWORD" | sed "s/'/''/g")
sed -i '/^DB_CONNECTION_STRING=/d' /opt/okane/.env
echo "DB_CONNECTION_STRING=Host=${db_host};Port=${db_port};Database=${db_name};Username=${db_username};Password='$DB_PASSWORD_ESCAPED'" >> /opt/okane/.env
MIGRATE_EOF
chmod 700 /opt/okane/migrate.sh
/opt/okane/migrate.sh

# Start in the plain-HTTP nginx config; nginx.https.conf.template references a
# certificate that doesn't exist yet, so switching to it is a one-time manual
# step (init-https.sh) run once DNS points at this host - see it and
# https_setup_command in `terraform output`.
cp /opt/okane/nginx/reverse-proxy.http.conf.template /opt/okane/nginx/active.conf.template

cat <<'INIT_HTTPS_EOF' > /opt/okane/init-https.sh
${init_https_script}
INIT_HTTPS_EOF
chmod +x /opt/okane/init-https.sh

# Reload nginx daily so it picks up certs renewed by the certbot container
# (renewal alone doesn't make nginx re-read the cert files off disk).
cat <<'CRON_EOF' > /etc/cron.d/okane-nginx-reload
0 3 * * * root cd /opt/okane && docker compose exec -T reverse-proxy nginx -s reload >>/var/log/okane-nginx-reload.log 2>&1
CRON_EOF

cd /opt/okane
docker compose pull
docker compose up -d
