# Copy this file to .env and fill in real values. .env is gitignored - never
# commit real secrets into this file.
#
# Used two ways:
#   1. Locally, `docker compose` auto-loads .env from this directory.
#   2. By Terraform (terraform/main.tf), which reads this same file and ships
#      it byte-for-byte to /opt/okane/.env on the EC2 instance, so local dev
#      and the deployed instance always agree on config.

# Docker Hub image tag to deploy for okane-api / okane-client.
IMAGE_TAG=v0.1.0

# Public domain the app is served at. Used by the reverse-proxy's nginx config
# and by terraform/templates/init-https.sh when requesting the TLS cert.
DOMAIN=okane.bloisdev.com

# Email Let's Encrypt uses for certificate expiry/urgent notices.
LETSENCRYPT_EMAIL=you@example.com

# HMAC signing key for JWT auth (Okane.Api's Jwt:SigningKey). A real secret -
# generate one with:
#   openssl rand -base64 64
JWT_SIGNING_KEY=
